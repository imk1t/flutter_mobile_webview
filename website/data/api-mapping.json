      "WKHTTPCookieStore": "https://developer.apple.com/documentation/webkit/wkhttpcookiestore",
      "HTTPCookie": "https://developer.apple.com/documentation/foundation/httpcookie",
      "WKUIDelegate": "https://developer.apple.com/documentation/webkit/wkuidelegate",
      "WKWindowFeatures": "https://developer.apple.com/documentation/webkit/wkwindowfeatures"
